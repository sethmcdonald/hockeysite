{
  "name": "hockey-decision-intelligence-platform",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter web typecheck",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose down",
    "db:generate": "pnpm --filter @hockey/db db:generate",
    "db:push": "pnpm --filter @hockey/db db:push",
    "db:migrate": "pnpm --filter @hockey/db db:migrate",
    "db:seed": "pnpm --filter @hockey/db db:seed",
    "db:studio": "pnpm --filter @hockey/db db:studio"
  }
}

