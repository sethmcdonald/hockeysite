generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Position {
  C
  LW
  RW
  D
  G
}

enum ShootsCatches {
  L
  R
}

/// Import batches let us track each raw load before normalization runs.
model RawImportBatch {
  id                    String            @id @default(cuid())
  source_system         String
  source_entity         String
  source_label          String?
  import_status         String
  row_count             Int?
  started_at            DateTime?
  completed_at          DateTime?
  notes                 String?
  created_at            DateTime          @default(now())
  updated_at            DateTime          @updatedAt
  raw_contract_years    RawContractYear[]
  raw_contracts         RawContract[]
  raw_player_seasons    RawPlayerSeason[]
  raw_players           RawPlayer[]
  raw_roster_snapshots  RawRosterSnapshot[]
  raw_seasons           RawSeason[]
  raw_teams             RawTeam[]
  raw_transactions      RawTransaction[]

  @@index([source_system, source_entity])
  @@index([import_status])
  @@map("raw_import_batches")
}

/// Raw players preserve source rows before we map them into canonical players.
model RawPlayer {
  id                    String         @id @default(cuid())
  import_batch_id       String
  source_system         String
  source_record_id      String
  external_nhl_id       Int?
  full_name             String?
  birth_date            DateTime?
  position_raw          String?
  shoots_catches_raw    String?
  payload               Json
  source_updated_at     DateTime?
  created_at            DateTime       @default(now())
  updated_at            DateTime       @updatedAt
  import_batch          RawImportBatch @relation(fields: [import_batch_id], references: [id], onDelete: Cascade)

  @@index([external_nhl_id])
  @@index([import_batch_id])
  @@unique([source_system, source_record_id])
  @@map("raw_players")
}

/// Raw teams preserve source rows before we map them into canonical teams.
model RawTeam {
  id                    String         @id @default(cuid())
  import_batch_id       String
  source_system         String
  source_record_id      String
  external_nhl_id       Int?
  name                  String?
  abbreviation          String?
  city                  String?
  conference            String?
  division              String?
  payload               Json
  source_updated_at     DateTime?
  created_at            DateTime       @default(now())
  updated_at            DateTime       @updatedAt
  import_batch          RawImportBatch @relation(fields: [import_batch_id], references: [id], onDelete: Cascade)

  @@index([external_nhl_id])
  @@index([import_batch_id])
  @@unique([source_system, source_record_id])
  @@map("raw_teams")
}

/// Raw seasons preserve cap-era season rows before they are normalized.
model RawSeason {
  id                    String         @id @default(cuid())
  import_batch_id       String
  source_system         String
  source_record_id      String
  season_code           String?
  start_year            Int?
  end_year              Int?
  salary_cap            Decimal?       @db.Decimal(12, 2)
  payload               Json
  source_updated_at     DateTime?
  created_at            DateTime       @default(now())
  updated_at            DateTime       @updatedAt
  import_batch          RawImportBatch @relation(fields: [import_batch_id], references: [id], onDelete: Cascade)

  @@index([import_batch_id])
  @@index([season_code])
  @@unique([source_system, source_record_id])
  @@map("raw_seasons")
}

/// Raw player season rows stay separate so transforms can reconcile duplicates or split-team cases.
model RawPlayerSeason {
  id                    String         @id @default(cuid())
  import_batch_id       String
  source_system         String
  source_record_id      String
  source_player_id      String?
  source_team_id        String?
  external_nhl_player_id Int?
  external_nhl_team_id  Int?
  season_code           String?
  games_played          Int?
  goals                 Int?
  assists               Int?
  points                Int?
  time_on_ice_seconds   Int?
  payload               Json
  source_updated_at     DateTime?
  created_at            DateTime       @default(now())
  updated_at            DateTime       @updatedAt
  import_batch          RawImportBatch @relation(fields: [import_batch_id], references: [id], onDelete: Cascade)

  @@index([external_nhl_player_id])
  @@index([external_nhl_team_id])
  @@index([import_batch_id])
  @@index([season_code])
  @@unique([source_system, source_record_id])
  @@map("raw_player_seasons")
}

/// Raw contracts preserve agreement-level source rows before contract normalization.
model RawContract {
  id                    String         @id @default(cuid())
  import_batch_id       String
  source_system         String
  source_record_id      String
  source_player_id      String?
  source_team_id        String?
  external_nhl_player_id Int?
  external_nhl_team_id  Int?
  sign_date             DateTime?
  start_season_code     String?
  end_season_code       String?
  term_years            Int?
  total_value           Decimal?       @db.Decimal(14, 2)
  average_annual_value  Decimal?       @db.Decimal(14, 2)
  contract_type         String?
  signing_status        String?
  payload               Json
  source_updated_at     DateTime?
  created_at            DateTime       @default(now())
  updated_at            DateTime       @updatedAt
  import_batch          RawImportBatch @relation(fields: [import_batch_id], references: [id], onDelete: Cascade)

  @@index([external_nhl_player_id])
  @@index([external_nhl_team_id])
  @@index([import_batch_id])
  @@unique([source_system, source_record_id])
  @@map("raw_contracts")
}

/// Raw contract years preserve year-level salary rows before contract_year transforms run.
model RawContractYear {
  id                    String         @id @default(cuid())
  import_batch_id       String
  source_system         String
  source_record_id      String
  source_contract_id    String?
  source_team_id        String?
  season_code           String?
  external_nhl_team_id  Int?
  cap_hit               Decimal?       @db.Decimal(14, 2)
  base_salary           Decimal?       @db.Decimal(14, 2)
  signing_bonus         Decimal?       @db.Decimal(14, 2)
  performance_bonus     Decimal?       @db.Decimal(14, 2)
  total_salary          Decimal?       @db.Decimal(14, 2)
  payload               Json
  source_updated_at     DateTime?
  created_at            DateTime       @default(now())
  updated_at            DateTime       @updatedAt
  import_batch          RawImportBatch @relation(fields: [import_batch_id], references: [id], onDelete: Cascade)

  @@index([external_nhl_team_id])
  @@index([import_batch_id])
  @@index([season_code])
  @@unique([source_system, source_record_id])
  @@map("raw_contract_years")
}

/// Raw transactions preserve source event rows before event normalization or enrichment.
model RawTransaction {
  id                    String         @id @default(cuid())
  import_batch_id       String
  source_system         String
  source_record_id      String
  source_player_id      String?
  source_from_team_id   String?
  source_to_team_id     String?
  transaction_date      DateTime?
  transaction_type      String?
  description           String?
  payload               Json
  source_updated_at     DateTime?
  created_at            DateTime       @default(now())
  updated_at            DateTime       @updatedAt
  import_batch          RawImportBatch @relation(fields: [import_batch_id], references: [id], onDelete: Cascade)

  @@index([import_batch_id])
  @@index([transaction_date])
  @@unique([source_system, source_record_id])
  @@map("raw_transactions")
}

/// Raw roster snapshots preserve source roster states before canonical roster history transforms.
model RawRosterSnapshot {
  id                    String         @id @default(cuid())
  import_batch_id       String
  source_system         String
  source_record_id      String
  source_player_id      String?
  source_team_id        String?
  season_code           String?
  snapshot_date         DateTime?
  roster_status         String?
  payload               Json
  source_updated_at     DateTime?
  created_at            DateTime       @default(now())
  updated_at            DateTime       @updatedAt
  import_batch          RawImportBatch @relation(fields: [import_batch_id], references: [id], onDelete: Cascade)

  @@index([import_batch_id])
  @@index([season_code])
  @@index([snapshot_date])
  @@unique([source_system, source_record_id])
  @@map("raw_roster_snapshots")
}

/// Canonical player records used across stats, contracts, and roster history.
model Player {
  id                      String                  @id @default(cuid())
  player_number_id        Int                     @unique @default(autoincrement())
  external_nhl_id         Int?                    @unique
  full_name               String
  birth_date              DateTime?
  position                Position?
  shoots_catches          ShootsCatches?
  height_inches           Int?
  weight_lbs              Int?
  draft_year              Int?
  draft_round             Int?
  draft_pick              Int?
  created_at              DateTime                @default(now())
  updated_at              DateTime                @updatedAt
  contracts               Contract[]
  player_advanced_seasons PlayerAdvancedSeason[]
  player_features         PlayerFeature[]
  player_seasons          PlayerSeason[]
  player_tracking_seasons PlayerTrackingSeason[]
  roster_snapshots        RosterSnapshot[]
  transactions            Transaction[]

  @@index([full_name])
  @@map("players")
}

/// Canonical team records kept separate from season-specific results.
model Team {
  id                      String                  @id @default(cuid())
  external_nhl_id         Int?                    @unique
  name                    String
  abbreviation            String                  @unique
  city                    String
  conference              String?
  division                String?
  created_at              DateTime                @default(now())
  updated_at              DateTime                @updatedAt
  contract_years          ContractYear[]
  outgoing_transactions   Transaction[]           @relation("FromTeam")
  incoming_transactions   Transaction[]           @relation("ToTeam")
  player_advanced_seasons PlayerAdvancedSeason[]
  player_features         PlayerFeature[]
  player_seasons          PlayerSeason[]
  player_tracking_seasons PlayerTrackingSeason[]
  roster_snapshots        RosterSnapshot[]
  signing_contracts       Contract[]              @relation("SigningTeamContracts")
  team_seasons            TeamSeason[]

  @@index([name])
  @@map("teams")
}

/// Season rows define the cap environment that later analytics will normalize against.
model Season {
  id                           String                  @id @default(cuid())
  season_code                  String                  @unique
  start_year                   Int
  end_year                     Int
  salary_cap                   Decimal?                @db.Decimal(12, 2)
  created_at                   DateTime                @default(now())
  updated_at                   DateTime                @updatedAt
  contract_years               ContractYear[]
  contracts_as_end_season      Contract[]              @relation("ContractEndSeason")
  contracts_as_start_season    Contract[]              @relation("ContractStartSeason")
  player_advanced_seasons      PlayerAdvancedSeason[]
  player_features              PlayerFeature[]
  player_seasons               PlayerSeason[]
  player_tracking_seasons      PlayerTrackingSeason[]
  roster_snapshots             RosterSnapshot[]
  team_seasons                 TeamSeason[]

  @@unique([start_year, end_year])
  @@map("seasons")
}

/// One row per player/team/season stop in the normalized warehouse.
model PlayerSeason {
  id                      String   @id @default(cuid())
  player_id               String
  season_id               String
  team_id                 String
  games_played            Int?
  time_on_ice_seconds     Int?
  goals                   Int?
  assists                 Int?
  points                  Int?
  shots                   Int?
  plus_minus              Int?
  penalty_minutes         Int?
  power_play_goals        Int?
  power_play_points       Int?
  short_handed_goals      Int?
  short_handed_points     Int?
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt
  player                  Player   @relation(fields: [player_id], references: [id], onDelete: Cascade)
  season                  Season   @relation(fields: [season_id], references: [id], onDelete: Cascade)
  team                    Team     @relation(fields: [team_id], references: [id], onDelete: Cascade)

  @@index([player_id])
  @@index([season_id])
  @@index([team_id])
  @@unique([player_id, season_id, team_id])
  @@map("player_seasons")
}

/// Team-level season outcomes remain separate from roster and player rows.
model TeamSeason {
  id                String   @id @default(cuid())
  team_id           String
  season_id         String
  wins              Int?
  losses            Int?
  overtime_losses   Int?
  points            Int?
  goals_for         Int?
  goals_against     Int?
  goal_differential Int?
  playoff_result    String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  season            Season   @relation(fields: [season_id], references: [id], onDelete: Cascade)
  team              Team     @relation(fields: [team_id], references: [id], onDelete: Cascade)

  @@index([team_id])
  @@index([season_id])
  @@unique([team_id, season_id])
  @@map("team_seasons")
}

/// Full contract records capture the agreement-level view.
model Contract {
  id                    String          @id @default(cuid())
  player_id             String
  signing_team_id       String
  sign_date             DateTime?
  start_season_id       String
  end_season_id         String
  term_years            Int
  total_value           Decimal?        @db.Decimal(14, 2)
  average_annual_value  Decimal?        @db.Decimal(14, 2)
  contract_type         String?
  signing_status        String?
  created_at            DateTime        @default(now())
  updated_at            DateTime        @updatedAt
  contract_years        ContractYear[]
  end_season            Season          @relation("ContractEndSeason", fields: [end_season_id], references: [id], onDelete: Restrict)
  player                Player          @relation(fields: [player_id], references: [id], onDelete: Cascade)
  signing_team          Team            @relation("SigningTeamContracts", fields: [signing_team_id], references: [id], onDelete: Restrict)
  start_season          Season          @relation("ContractStartSeason", fields: [start_season_id], references: [id], onDelete: Restrict)
  transactions          Transaction[]

  @@index([player_id])
  @@index([signing_team_id])
  @@index([start_season_id])
  @@index([end_season_id])
  @@map("contracts")
}

/// Contract years break each contract into season-level cap and salary rows.
model ContractYear {
  id                String   @id @default(cuid())
  contract_id       String
  season_id         String
  team_id           String
  cap_hit           Decimal? @db.Decimal(14, 2)
  base_salary       Decimal? @db.Decimal(14, 2)
  signing_bonus     Decimal? @db.Decimal(14, 2)
  performance_bonus Decimal? @db.Decimal(14, 2)
  total_salary      Decimal? @db.Decimal(14, 2)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  contract          Contract @relation(fields: [contract_id], references: [id], onDelete: Cascade)
  season            Season   @relation(fields: [season_id], references: [id], onDelete: Restrict)
  team              Team     @relation(fields: [team_id], references: [id], onDelete: Restrict)

  @@index([contract_id])
  @@index([season_id])
  @@index([team_id])
  @@unique([contract_id, season_id])
  @@map("contract_years")
}

/// Transactions are separate from contracts so future event ingestion can stay append-friendly.
model Transaction {
  id                String    @id @default(cuid())
  transaction_date  DateTime
  transaction_type  String
  player_id         String?
  from_team_id      String?
  to_team_id        String?
  contract_id       String?
  description       String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  contract          Contract? @relation(fields: [contract_id], references: [id], onDelete: SetNull)
  from_team         Team?     @relation("FromTeam", fields: [from_team_id], references: [id], onDelete: SetNull)
  player            Player?   @relation(fields: [player_id], references: [id], onDelete: SetNull)
  to_team           Team?     @relation("ToTeam", fields: [to_team_id], references: [id], onDelete: SetNull)

  @@index([contract_id])
  @@index([from_team_id])
  @@index([player_id])
  @@index([to_team_id])
  @@index([transaction_date])
  @@map("transactions")
}

/// Roster snapshots make historical roster reconstruction possible later.
model RosterSnapshot {
  id             String   @id @default(cuid())
  snapshot_date  DateTime
  team_id        String
  player_id      String
  season_id      String
  roster_status  String
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  player         Player   @relation(fields: [player_id], references: [id], onDelete: Cascade)
  season         Season   @relation(fields: [season_id], references: [id], onDelete: Cascade)
  team           Team     @relation(fields: [team_id], references: [id], onDelete: Cascade)

  @@index([player_id])
  @@index([season_id])
  @@index([snapshot_date])
  @@index([team_id])
  @@unique([snapshot_date, team_id, player_id])
  @@map("roster_snapshots")
}

/// Source-specific advanced metrics stay isolated from the warehouse core.
model PlayerAdvancedSeason {
  id                        String   @id @default(cuid())
  player_id                 String
  season_id                 String
  team_id                   String
  source                    String
  corsi_for_pct             Float?
  fenwick_for_pct           Float?
  expected_goals_for_pct    Float?
  individual_expected_goals Float?
  goals_above_replacement   Float?
  wins_above_replacement    Float?
  offensive_rapm            Float?
  defensive_rapm            Float?
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt
  player                    Player   @relation(fields: [player_id], references: [id], onDelete: Cascade)
  season                    Season   @relation(fields: [season_id], references: [id], onDelete: Cascade)
  team                      Team     @relation(fields: [team_id], references: [id], onDelete: Cascade)

  @@index([player_id])
  @@index([season_id])
  @@index([team_id])
  @@unique([player_id, season_id, team_id, source])
  @@map("player_advanced_seasons")
}

/// Tracking metrics are separate because source coverage starts much later than 2005.
model PlayerTrackingSeason {
  id                      String   @id @default(cuid())
  player_id               String
  season_id               String
  team_id                 String
  source                  String
  top_speed_mph           Float?
  avg_speed_mph           Float?
  speed_bursts_20_plus    Int?
  zone_entries            Int?
  zone_exits              Int?
  puck_possession_seconds Int?
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt
  player                  Player   @relation(fields: [player_id], references: [id], onDelete: Cascade)
  season                  Season   @relation(fields: [season_id], references: [id], onDelete: Cascade)
  team                    Team     @relation(fields: [team_id], references: [id], onDelete: Cascade)

  @@index([player_id])
  @@index([season_id])
  @@index([team_id])
  @@unique([player_id, season_id, team_id, source])
  @@map("player_tracking_seasons")
}

/// Internal feature rows are a future-ready spot for normalized hockey decision features.
model PlayerFeature {
  id                 String   @id @default(cuid())
  player_id          String
  season_id          String
  team_id            String
  offensive_creation Float?
  finishing          Float?
  playmaking         Float?
  transition_value   Float?
  defensive_value    Float?
  power_play_value   Float?
  penalty_kill_value Float?
  durability         Float?
  usage_difficulty   Float?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
  player             Player   @relation(fields: [player_id], references: [id], onDelete: Cascade)
  season             Season   @relation(fields: [season_id], references: [id], onDelete: Cascade)
  team               Team     @relation(fields: [team_id], references: [id], onDelete: Cascade)

  @@index([player_id])
  @@index([season_id])
  @@index([team_id])
  @@unique([player_id, season_id, team_id])
  @@map("player_features")
}
