{
  "name": "@hockey/db",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "node scripts/run-node-with-env.js prisma/seed.js"
  },
  "scripts": {
    "db:generate": "node scripts/generate-client.js",
    "db:push": "node scripts/run-prisma.js db push --schema prisma/schema.prisma",
    "db:migrate": "node scripts/run-prisma.js migrate dev --skip-generate --schema prisma/schema.prisma",
    "db:seed": "node scripts/run-node-with-env.js prisma/seed.js",
    "db:validate": "node scripts/run-node-with-env.js prisma/validate.js",
    "db:studio": "node scripts/run-prisma.js studio --schema prisma/schema.prisma",
    "import:raw:players": "node scripts/run-node-with-env.js scripts/import-raw-players.js",
    "import:raw:teams": "node scripts/run-node-with-env.js scripts/import-raw-teams.js",
    "normalize:detroit": "node scripts/run-node-with-env.js scripts/normalize-detroit.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "typescript": "^5.0.0"
  }
}

